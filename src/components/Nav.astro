---
import { ui } from "../lib/icons";

const links = [
  { href: "#work", label: "Work" },
  { href: "#ai", label: "AI" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-nav" data-nav>
  <div class="site-nav__progress" data-nav-progress aria-hidden="true"></div>
  <div class="site-nav__inner container">
    <a class="site-nav__brand" href="#top" aria-label="Khalil Ben Ali — home">
      KB<span class="gradient-text">.</span>
    </a>

    <nav class="site-nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} data-nav-link={link.href.slice(1)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-nav__actions">
      <a
        class="icon-btn"
        href="https://github.com/khalilBenAli1"
        aria-label="GitHub profile"
        set:html={ui.github}
      />
      <a
        class="icon-btn"
        href="https://linkedin.com/in/khalil-ben-ali"
        aria-label="LinkedIn profile"
        set:html={ui.linkedin}
      />
      <a class="btn btn--primary site-nav__resume" href="/resume/">Résumé</a>
      <button
        class="site-nav__burger icon-btn"
        data-nav-burger
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        set:html={ui.menu}
      />
    </div>
  </div>

  <div class="site-nav__overlay" id="mobile-menu" data-nav-overlay hidden>
    <button
      class="site-nav__close icon-btn"
      data-nav-close
      aria-label="Close menu"
      set:html={ui.x}
    />
    <nav aria-label="Mobile">
      {
        links.map((link, i) => (
          <a href={link.href} style={`--i:${i}`} data-nav-overlay-link>
            {link.label}
          </a>
        ))
      }
      <a href="/resume/" style={`--i:${links.length}`} data-nav-overlay-link>
        Résumé
      </a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    background: rgba(6, 7, 12, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-nav__progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-nav__links {
    display: flex;
    gap: 1.9rem;
  }

  .site-nav__links a {
    position: relative;
    padding-block: 0.35rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-nav__links a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a.is-active {
    color: var(--text);
  }

  .site-nav__links a.is-active::after {
    transform: scaleX(1);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-nav__resume {
    min-height: 2.35rem;
    padding: 0.42rem 1.05rem;
    font-size: 0.875rem;
  }

  .site-nav__burger {
    display: none;
  }

  .site-nav__overlay[hidden] {
    display: none;
  }

  .site-nav__overlay {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-content: center;
    background: rgba(6, 7, 12, 0.96);
    backdrop-filter: blur(10px);
  }

  .site-nav__overlay nav {
    display: grid;
    gap: 1.4rem;
    text-align: center;
  }

  .site-nav__overlay a {
    opacity: 0;
    transform: translateY(14px);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transition-delay: calc(var(--i) * 70ms);
  }

  .site-nav__overlay.is-open a {
    opacity: 1;
    transform: none;
  }

  .site-nav__overlay a:hover {
    color: var(--violet-soft);
  }

  .site-nav__close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
  }

  @media (max-width: 51.25rem) {
    .site-nav__links,
    .site-nav__resume {
      display: none;
    }

    .site-nav__burger {
      display: inline-flex;
    }
  }
</style>
