---
import RollLabel from "./RollLabel.astro";
import { ui } from "../lib/icons";
import { homePath, locales, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const links = [
  { href: "#work", id: "work", label: dict.nav.work },
  { href: "#ai", id: "ai", label: dict.nav.ai },
  { href: "#experience", id: "experience", label: dict.nav.experience },
  { href: "#contact", id: "contact", label: dict.nav.contact },
];
---

<header class="site-nav" data-nav>
  <div class="site-nav__progress" data-nav-progress aria-hidden="true"></div>
  <div class="site-nav__inner container">
    <a class="site-nav__brand" href="#top" aria-label="Khalil Ben Ali — home">
      KB<span class="gradient-text">.</span>
    </a>

    <nav class="site-nav__links" aria-label="Primary">
      {
        links.map((link) => (
          <a class="link-roll" href={link.href} data-nav-link={link.id}>
            <RollLabel label={link.label} />
          </a>
        ))
      }
    </nav>

    <div class="site-nav__actions">
      <div class="site-nav__langs" aria-label="Language">
        {
          locales.map((l) => (
            <a
              href={homePath(l)}
              class:list={[{ "is-current": l === locale }]}
              aria-current={l === locale ? "page" : undefined}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      <a
        class="icon-btn"
        href="https://github.com/khalilBenAli1"
        aria-label="GitHub profile"
        set:html={ui.github}
      />
      <a
        class="icon-btn"
        href="https://linkedin.com/in/khalil-ben-ali"
        aria-label="LinkedIn profile"
        set:html={ui.linkedin}
      />
      <a class="btn btn--primary site-nav__resume" href={`/${locale === "en" ? "" : locale + "/"}resume/`}>
        {dict.nav.resume}
      </a>
      <button
        class="site-nav__burger icon-btn"
        data-nav-burger
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        set:html={ui.menu}
      />
    </div>
  </div>

  <div class="site-nav__overlay" id="mobile-menu" data-nav-overlay hidden>
    <button
      class="site-nav__close icon-btn"
      data-nav-close
      aria-label="Close"
      set:html={ui.x}
    />
    <nav aria-label="Mobile">
      {
        links.map((link, i) => (
          <a href={link.href} style={`--i:${i}`} data-nav-overlay-link>
            {link.label}
          </a>
        ))
      }
      <a
        href={`/${locale === "en" ? "" : locale + "/"}resume/`}
        style={`--i:${links.length}`}
        data-nav-overlay-link
      >
        {dict.nav.resume}
      </a>
      <div class="site-nav__overlay-langs" style={`--i:${links.length + 1}`}>
        {
          locales.map((l) => (
            <a
              href={homePath(l)}
              class:list={[{ "is-current": l === locale }]}
              data-nav-overlay-link
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    height: var(--nav-h);
    border-bottom: 1px solid var(--border);
    background: rgba(6, 7, 12, 0.65);
    /* -webkit- first for older Safari; standard property last. */
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-nav__progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .site-nav__brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    /* D2: nothing on the page carries 700, the wordmark included. */
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .site-nav__links {
    display: flex;
    gap: 1.9rem;
  }

  .site-nav__links a {
    position: relative;
    padding-block: 0.35rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-nav__links a::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .site-nav__links a:hover,
  .site-nav__links a.is-active {
    color: var(--text);
  }

  .site-nav__links a.is-active::after {
    transform: scaleX(1);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .site-nav__langs {
    display: flex;
    gap: 0.1rem;
    margin-right: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .site-nav__langs a {
    padding: 0.3rem 0.4rem;
    border-radius: var(--r-chip);
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .site-nav__langs a:hover {
    color: var(--text);
  }

  .site-nav__langs a.is-current {
    background: rgba(124, 92, 255, 0.16);
    color: var(--violet-soft);
  }

  .site-nav__resume {
    min-height: 2.35rem;
    padding: 0.42rem 1.05rem;
    font-size: 0.875rem;
  }

  .site-nav__burger {
    display: none;
  }

  .site-nav__overlay[hidden] {
    display: none;
  }

  .site-nav__overlay {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-content: center;
    background: rgba(6, 7, 12, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .site-nav__overlay nav {
    display: grid;
    gap: 1.4rem;
    text-align: center;
  }

  .site-nav__overlay a {
    opacity: 0;
    transform: translateY(14px);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 2rem;
    /* D2 again: display sizes never carry 700. */
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .site-nav__overlay.is-open a {
    opacity: 1;
    transform: none;
  }

  .site-nav__overlay a:hover {
    color: var(--violet-soft);
  }

  .site-nav__overlay-langs {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
  }

  .site-nav__overlay-langs a {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--muted);
  }

  .site-nav__overlay-langs a.is-current {
    color: var(--violet-soft);
  }

  .site-nav__close {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
  }

  @media (max-width: 51.25rem) {
    .site-nav__links,
    .site-nav__resume,
    .site-nav__langs {
      display: none;
    }

    .site-nav__burger {
      display: inline-flex;
    }
  }
</style>
