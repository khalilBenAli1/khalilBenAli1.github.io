---
import { t, type Locale } from "../../lib/i18n";
import { ui } from "../../lib/icons";
const { locale } = Astro.props as { locale: Locale };
const dict = t(locale);
---
<div class="island-contact">
  <div class="island-contact__introduction">
    <p class="island-contact__original-title">{dict.contact.title.replace(/\*/g, '')}</p>
    <p class="island-contact__line">{dict.contact.line}</p>
    <p class="island-section-availability"><span aria-hidden="true"></span>{dict.hero.status}</p>
  </div>
  <a class="island-contact__email" href="mailto:khalil.benali16121@gmail.com" aria-label={dict.contact.email}>
    <span class="island-contact__email-label">{dict.contact.email}</span>
    <span class="island-contact__email-address" aria-hidden="true">khalil.benali16121@gmail.com</span>
    <span class="island-contact__email-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="island-contact__socials">
    <a href="https://github.com/khalilBenAli1"><span class="island-contact__social-icon" aria-hidden="true" set:html={ui.github} /><span>GitHub</span><span class="island-contact__social-arrow" aria-hidden="true">↗</span></a>
    <a href="https://linkedin.com/in/khalil-ben-ali"><span class="island-contact__social-icon" aria-hidden="true" set:html={ui.linkedin} /><span>LinkedIn</span><span class="island-contact__social-arrow" aria-hidden="true">↗</span></a>
  </div>
  <span class="sr-only" aria-hidden="true">{dict.contact.ghost}</span>
</div>
<footer class="island-footer"><p>{dict.contact.footerLeft}</p><p class="island-clock"><span>{dict.contact.localTime}</span><strong>FAENZA · <span data-local-time>--:--</span></strong></p><div><p>{dict.contact.footerRight}</p><a href="#top" aria-label={dict.contact.backToTop}>↑</a></div></footer>
