---
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import {
  cvFile,
  homePath,
  locales,
  resumePath,
  t,
  type Locale,
} from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const r = dict.resume;

const roleEntries = [r.freelance, r.solvr, r.tynass];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={dict.meta.description} />
    <meta name="theme-color" content="#06070C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(resumePath(l), Astro.site)}
        />
      ))
    }
    <title>{r.title}</title>
  </head>
  <body>
    <a class="skip-link resume-skip" href="#resume">{r.skipLink}</a>

    <main class="resume-shell">
      <nav class="resume-actions" aria-label="Résumé actions">
        <a class="back-link" href={homePath(locale)}>{r.backLink}</a>
        <div class="lang-links" aria-label="Language">
          {
            locales.map((l) => (
              <a
                href={resumePath(l)}
                class:list={[{ "is-current": l === locale }]}
                aria-current={l === locale ? "page" : undefined}
              >
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
        <a class="download-link" href={cvFile(locale)} download>
          {r.downloadPdf}
        </a>
      </nav>

      <article class="resume-sheet" id="resume" aria-labelledby="resume-name">
        <header class="resume-header">
          <img
            class="resume-photo"
            src="/khalil.jpg"
            alt={r.photoAlt}
            width="640"
            height="640"
          />
          <div class="identity-line">
            <h1 id="resume-name">KHALIL BEN ALI</h1>
            <p class="role">{r.role}</p>
          </div>
          <p class="contact-line">
            {r.location} ·
            <a href="mailto:khalil.benali16121@gmail.com"
              >khalil.benali16121@gmail.com</a
            >
            · <a href="https://github.com/khalilBenAli1">github.com/khalilBenAli1</a>
            ·
            <a href="https://linkedin.com/in/khalil-ben-ali"
              >linkedin.com/in/khalil-ben-ali</a
            >
          </p>
        </header>

        <div class="resume-body">
          <div class="resume-main">
            <section class="summary-section" aria-labelledby="summary-title">
              <h2 id="summary-title">{r.sections.summary}</h2>
              <p>{r.summary}</p>
            </section>

            <section class="experience-section" aria-labelledby="experience-title">
              <h2 id="experience-title">{r.sections.experience}</h2>

              <div class="role-entry">
                <h3><strong>{r.nbold.heading}</strong></h3>
                <p class="role-context">{r.nbold.context}</p>
                <ul>
                  {r.nbold.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>

              {
                roleEntries.map((entry) => (
                  <div class="role-entry compact-entry">
                    <h3>
                      <strong>{entry.heading}</strong>
                    </h3>
                    <ul>
                      {entry.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </section>
          </div>

          <aside class="resume-side" aria-label="Details">
            <section aria-labelledby="skills-title">
              <h2 id="skills-title">{r.sections.skills}</h2>
              <p>{r.skillsLine}</p>
            </section>

            <section aria-labelledby="projects-title">
              <h2 id="projects-title">{r.sections.projects}</h2>
              <ul>
                {r.sideProjects.map((sp) => <li>{sp}</li>)}
              </ul>
            </section>

            <section aria-labelledby="education-title">
              <h2 id="education-title">{r.sections.education}</h2>
              <p>{r.education}</p>
            </section>

            <section aria-labelledby="languages-title">
              <h2 id="languages-title">{r.sections.languages}</h2>
              <p class="languages">{r.languagesLine}</p>
            </section>
          </aside>
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 14mm;
  }

  :global(html) {
    background: #06070c;
  }

  :global(body) {
    min-width: 0;
    margin: 0;
    color: var(--ink, #0e0e12);
    background: #06070c;
    font-family: var(--font-body);
  }

  .resume-skip {
    position: fixed;
    z-index: 10;
    top: 0.75rem;
    left: 0.75rem;
    transform: translateY(-180%);
    padding: 0.6rem 0.8rem;
    color: #f2f4fa;
    background: #7c5cff;
  }

  .resume-skip:focus {
    transform: translateY(0);
  }

  .resume-shell {
    min-height: 100vh;
    padding: clamp(1.25rem, 4vw, 3.5rem) clamp(1.25rem, 4vw, 4rem);
    overflow-x: clip;
  }

  .resume-actions {
    display: flex;
    width: min(210mm, 100%);
    margin: 0 auto 1rem;
    align-items: center;
    justify-content: flex-end;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .resume-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border-radius: 3px;
    text-decoration: none;
  }

  .resume-actions a:focus-visible {
    outline: 3px solid #7c5cff;
    outline-offset: 3px;
  }

  .back-link {
    margin-right: auto;
    padding: 0.65rem 0.25rem;
    color: #9d8cff;
  }

  .lang-links {
    display: flex;
    gap: 0.15rem;
  }

  .lang-links a {
    min-height: 2.2rem;
    padding: 0.35rem 0.55rem;
    border-radius: 6px;
    color: #97a0b8;
  }

  .lang-links a:hover {
    color: #f2f4fa;
  }

  .lang-links a.is-current {
    background: rgba(124, 92, 255, 0.16);
    color: #9d8cff;
  }

  .download-link {
    padding: 0.65rem 0.9rem;
    color: #fff;
    background: #7c5cff;
  }

  .resume-sheet {
    box-sizing: border-box;
    width: min(210mm, 100%);
    min-height: 297mm;
    margin: 0 auto;
    padding: 14mm;
    color: var(--ink, #0e0e12);
    background: #f2f1ec;
    box-shadow: 0 1.25rem 4rem rgb(0 0 0 / 45%);
    font-size: 0.72rem;
    line-height: 1.34;
  }

  .resume-header {
    position: relative;
    padding-right: 92px;
    padding-bottom: 4mm;
    border-bottom: 2px solid #7c5cff;
  }

  .resume-photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 76px;
    height: 76px;
    border: 2px solid #7c5cff;
    border-radius: 50%;
    object-fit: cover;
  }

  .identity-line {
    display: flex;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h1,
  h2,
  h3,
  p,
  ul {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    color: #0e0e12;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .role {
    margin-bottom: 0;
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
  }

  .contact-line {
    margin: 2.4mm 0 0;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    line-height: 1.3;
  }

  .contact-line a {
    color: inherit;
    text-decoration-color: #7c5cff;
    text-underline-offset: 0.12em;
  }

  .resume-body {
    display: grid;
    grid-template-columns: minmax(0, 68fr) minmax(0, 32fr);
    gap: 6mm;
    padding-top: 4mm;
  }

  .resume-main,
  .resume-side {
    min-width: 0;
  }

  section {
    break-inside: avoid;
  }

  h2 {
    margin-bottom: 1.7mm;
    padding-bottom: 0.8mm;
    border-bottom: 1px solid #7c5cff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.1em;
  }

  .summary-section p {
    margin-bottom: 3.5mm;
  }

  h3 {
    margin-bottom: 0.7mm;
    font-size: 0.74rem;
    line-height: 1.22;
  }

  h3 strong {
    font-weight: 700;
  }

  p {
    margin-bottom: 2.3mm;
  }

  .role-entry {
    break-inside: avoid;
    margin-bottom: 2.2mm;
  }

  .role-context {
    margin-bottom: 1.2mm;
    font-style: italic;
  }

  ul {
    margin-bottom: 0;
    padding-left: 1.1em;
  }

  li {
    margin-bottom: 0.9mm;
    padding-left: 0.15em;
  }

  li::marker {
    color: #7c5cff;
  }

  .compact-entry {
    margin-bottom: 1.8mm;
  }

  .compact-entry li {
    margin-bottom: 0;
  }

  .resume-side {
    padding-left: 5mm;
    border-left: 1px solid #9d8cff;
  }

  .resume-side section {
    margin-bottom: 4.5mm;
  }

  .resume-side p,
  .resume-side li {
    margin-bottom: 1.8mm;
  }

  .languages {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  @media (max-width: 700px) {
    .resume-shell {
      padding: 1rem;
    }

    .resume-actions {
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .resume-sheet {
      min-height: auto;
      padding: clamp(1.25rem, 5vw, 2rem);
      font-size: 0.83rem;
      line-height: 1.45;
    }

    .resume-header {
      padding-right: 0;
      padding-top: 88px;
    }

    .resume-photo {
      right: auto;
      left: 0;
    }

    .identity-line {
      display: block;
    }

    h1 {
      font-size: clamp(1.65rem, 8vw, 2.4rem);
    }

    .role {
      margin-top: 0.55rem;
      white-space: normal;
    }

    .contact-line {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      font-size: 0.66rem;
      overflow-wrap: anywhere;
    }

    .resume-body {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .resume-side {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media print {
    :global(html),
    :global(body) {
      width: 210mm;
      min-width: 210mm;
      height: 297mm;
      background: #f2f1ec;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .resume-skip,
    .resume-actions {
      display: none;
    }

    .resume-shell {
      width: auto;
      min-height: 0;
      padding: 0;
      overflow: visible;
    }

    .resume-sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
      font-size: 9.6pt;
      line-height: 1.3;
    }

    .resume-header {
      padding-right: 26mm;
      padding-bottom: 3mm;
    }

    .resume-photo {
      width: 22mm;
      height: 22mm;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    h1 {
      font-size: 18pt;
    }

    .role {
      font-size: 9.5pt;
    }

    .contact-line {
      margin-top: 2.2mm;
      font-size: 7.6pt;
    }

    .resume-body {
      grid-template-columns: minmax(0, 68fr) minmax(0, 32fr);
      gap: 5mm;
      padding-top: 3mm;
    }

    h2 {
      margin-bottom: 1.6mm;
      padding-bottom: 0.8mm;
      font-size: 7.8pt;
    }

    .summary-section p {
      margin-bottom: 2.5mm;
    }

    h3 {
      margin-bottom: 0.7mm;
      font-size: 9.9pt;
    }

    p {
      margin-bottom: 1.55mm;
    }

    .role-entry {
      margin-bottom: 2.2mm;
    }

    .role-context {
      margin-bottom: 0.75mm;
    }

    li {
      margin-bottom: 1.2mm;
    }

    .compact-entry {
      margin-bottom: 1.05mm;
    }

    .resume-side {
      padding-left: 3.5mm;
    }

    .resume-side section {
      margin-bottom: 4.5mm;
    }

    .resume-side p,
    .resume-side li {
      margin-bottom: 1.15mm;
    }

    a,
    a:visited {
      color: inherit;
      text-decoration: none;
    }

    a[href]::after {
      content: none;
    }
  }
</style>
