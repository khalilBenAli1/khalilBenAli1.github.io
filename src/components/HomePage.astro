---
import Base from "../layouts/Base.astro";
import IslandHeader from "./island/IslandHeader.astro";
import IslandHero from "./island/IslandHero.astro";
import IslandPanel from "./island/IslandPanel.astro";
import WorkContent from "./island/WorkContent.astro";
import AboutContent from "./island/AboutContent.astro";
import ExperienceContent from "./island/ExperienceContent.astro";
import ContactContent from "./island/ContactContent.astro";
import { homePath, locales, t, type Locale } from "../lib/i18n";
import { getIslandCopy } from "../lib/island/copy";
import { sceneScreens } from "../lib/island/content";
import "../styles/island.css";
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const copy = getIslandCopy(locale);
const alternates = Object.fromEntries(locales.map((language) => [language, homePath(language)]));
const screenJson = JSON.stringify(sceneScreens).replace(/</g, "\\u003c");
---
<Base island lang={locale} title={dict.meta.title} description={dict.meta.description} skipLinkLabel={dict.skipLink} alternates={alternates}>
  <div class="island-app" data-island-root data-locale={locale}>
    <IslandHeader locale={locale} />
    <main id="main-content">
      <IslandHero locale={locale} />
      <div class="island-panels">
        <IslandPanel destination="work" index="01" eyebrow={dict.work.eyebrow} title={copy.gallery.title} locale={locale}>
          <p class="island-panel__intro">{dict.work.title.replace(/\*/g, '')}</p>
          <WorkContent locale={locale} />
        </IslandPanel>
        <IslandPanel destination="about" index="02" eyebrow={copy.destinations.about} title={copy.about.title} locale={locale}><AboutContent locale={locale} /></IslandPanel>
        <IslandPanel destination="experience" index="03" eyebrow={dict.experience.eyebrow} title={copy.experience.title} locale={locale}><ExperienceContent locale={locale} /></IslandPanel>
        <IslandPanel destination="contact" index="04" eyebrow={dict.contact.eyebrow} title={copy.contact.title} locale={locale}><ContactContent locale={locale} /></IslandPanel>
      </div>
    </main>
    <script is:inline type="application/json" data-island-screens set:html={screenJson} />
  </div>
  <script>
    import "../scripts/island/controller";
  </script>
</Base>
