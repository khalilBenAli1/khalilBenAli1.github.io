---
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import TechMarquee from "./TechMarquee.astro";
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "./SectionHeading.astro";
import Diagram from "./Diagram.astro";
import AiSection from "./AiSection.astro";
import Experience from "./Experience.astro";
import SkillsSection from "./SkillsSection.astro";
import Contact from "./Contact.astro";
import { ui } from "../lib/icons";
import { homePath, locales, t, type Locale } from "../lib/i18n";
import {
  audioDiagram,
  cuddyDiagram,
  lorDiagram,
  meetingDiagram,
  scannerDiagram,
} from "../lib/diagrams-data";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const p = dict.work.projects;

const alternates = Object.fromEntries(locales.map((l) => [l, homePath(l)]));
---

<Base
  space
  lang={locale}
  title={dict.meta.title}
  description={dict.meta.description}
  skipLinkLabel={dict.skipLink}
  alternates={alternates}
>
  <Nav locale={locale} />

  <main id="main-content">
    <Hero locale={locale} />
    <TechMarquee />

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="container">
        <SectionHeading
          index="01"
          eyebrow={dict.work.eyebrow}
          title={dict.work.title}
          titleId="work-title"
        />

        {/*
          No .dim-siblings here on purpose. It works on a grid you can take in at
          a glance; these cards are full-width and taller than the viewport, so
          dimming "the others" only ever dims something off-screen while the
          pointer is simply travelling across the card you are already reading.
        */}
        <ProjectCard
          locale={locale}
          index="01"
          icon="brain-circuit"
          name="Cuddy Brain"
          subtitle={p.cuddy.subtitle}
          year="2024 → 2026"
          client="Cuddy Financial"
          production
          highlights={p.cuddy.highlights}
          techNames={[
            "NestJS",
            "PostgreSQL",
            "Redis",
            "Azure OpenAI",
            "LangChain",
            "React",
            "Microsoft Teams",
            "Salesforce",
          ]}
        >
          <Diagram {...cuddyDiagram} />
        </ProjectCard>

        <ProjectCard
          locale={locale}
          index="02"
          icon="coffee"
          name="L'OR Unlimited Remix"
          subtitle={p.lor.subtitle}
          year="2026"
          client="JDE × HLWN"
          production
          flip
          highlights={p.lor.highlights}
          techNames={[
            "Next.js",
            "React",
            "TypeScript",
            "Gemini",
            "transformers.js",
            "WebGL",
            "Tailwind",
            "Vercel",
          ]}
        >
          <Diagram {...lorDiagram} />
        </ProjectCard>

        <ProjectCard
          locale={locale}
          index="03"
          icon="radio"
          name="nBold Meeting Intelligence"
          subtitle={p.meeting.subtitle}
          year="2026"
          client="nBold"
          highlights={p.meeting.highlights}
          techNames={[
            "NestJS",
            "Microsoft Graph",
            "RabbitMQ",
            "PostgreSQL",
            "Azure OpenAI",
            "Salesforce",
          ]}
        >
          <Diagram {...meetingDiagram} />
        </ProjectCard>

        <ProjectCard
          locale={locale}
          index="04"
          icon="scan-line"
          name="Cuddy Scanner"
          subtitle={p.scanner.subtitle}
          year="2025 → 2026"
          client="Cuddy Financial"
          production
          flip
          highlights={p.scanner.highlights}
          techNames={["C#", ".NET 9", "WPF", "SharePoint", "LiteDB", "MSAL"]}
        >
          <Diagram {...scannerDiagram} />
        </ProjectCard>

        <ProjectCard
          locale={locale}
          index="05"
          icon="audio-waveform"
          name="HyperMesh & HyperGpu DSP"
          subtitle={p.audio.subtitle}
          year="2026"
          client="R&D"
          highlights={p.audio.highlights}
          techNames={["C++20", "JUCE", "CMake", "Protobuf", "SQLite"]}
        >
          <Diagram {...audioDiagram} />
        </ProjectCard>

        <div class="more-work card-v3" data-reveal="fade">
          <div class="more-work__biat">
            <span class="more-work__icon" set:html={ui.database} />
            <div>
              <h3>Assurances BIAT KB</h3>
              <p>{dict.work.biatText}</p>
            </div>
            <a
              class="btn btn--ghost more-work__code"
              href="https://github.com/khalilBenAli1/knowledgebase-"
            >
              <span set:html={ui.github} />
              {dict.work.viewCode}
            </a>
          </div>
          <div class="more-work__cta">
            <p>{dict.work.moreLine}</p>
            <a class="btn btn--ghost" href="https://github.com/khalilBenAli1">
              <span set:html={ui.github} />
              github.com/khalilBenAli1
            </a>
          </div>
        </div>
      </div>
    </section>

    <AiSection locale={locale} />
    <Experience locale={locale} />
    <SkillsSection locale={locale} />
    <Contact locale={locale} />
  </main>

  <script>
    import "../scripts/site";
  </script>
</Base>

<style>
  .more-work {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .more-work__biat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }

  .more-work__biat > div {
    flex: 1 1 18rem;
  }

  .more-work__icon {
    display: inline-flex;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.5rem;
    border: 1px solid var(--border-accent);
    border-radius: var(--r-btn);
    background: rgba(124, 92, 255, 0.12);
    color: var(--violet-soft);
  }

  .more-work__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .more-work__biat h3 {
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .more-work__biat p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .more-work__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .more-work__cta p {
    margin: 0;
    color: var(--muted);
  }
</style>
