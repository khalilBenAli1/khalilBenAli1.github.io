---
import { ui } from "../lib/icons";
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <p class="eyebrow">{dict.contact.eyebrow}</p>
    <h2 class="section-title gradient-text" id="contact-title">
      {dict.contact.title}
    </h2>
    <p class="contact__line">{dict.contact.line}</p>
    <div class="contact__actions">
      <a
        class="btn btn--primary"
        href="mailto:khalil.benali16121@gmail.com"
        data-magnetic
      >
        <span set:html={ui.mail} />
        {dict.contact.email}
      </a>
      <a class="btn btn--ghost" href="https://github.com/khalilBenAli1" data-magnetic>
        <span set:html={ui.github} />
        GitHub
      </a>
      <a
        class="btn btn--ghost"
        href="https://linkedin.com/in/khalil-ben-ali"
        data-magnetic
      >
        <span set:html={ui.linkedin} />
        LinkedIn
      </a>
    </div>
  </div>

  <footer class="contact__footer">
    <div class="container contact__footer-inner">
      <p>{dict.contact.footerLeft}</p>
      <p>{dict.contact.footerRight}</p>
      <a
        class="icon-btn"
        href="#top"
        aria-label={dict.contact.backToTop}
        set:html={ui["arrow-up"]}
      />
    </div>
  </footer>
</section>

<style>
  .contact {
    padding-block-end: 0;
    text-align: center;
  }

  .contact__inner {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding-block-end: clamp(4rem, 8vw, 6rem);
  }

  .contact .section-title {
    max-width: none;
  }

  .contact__line {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 1.2rem;
  }

  .contact__footer {
    border-top: 1px solid var(--border);
    background: rgba(6, 7, 12, 0.6);
  }

  .contact__footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-block: 1.4rem;
  }

  .contact__footer p {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (max-width: 40rem) {
    .contact__footer-inner {
      justify-content: center;
      text-align: center;
    }
  }
</style>
