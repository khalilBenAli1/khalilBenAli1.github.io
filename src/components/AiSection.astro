---
import { ui } from "../lib/icons";
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const icons = ["brain-circuit", "shield-check"];
---

<section class="section ai-section" id="ai" aria-labelledby="ai-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">{dict.ai.eyebrow}</p>
      <h2 class="section-title" id="ai-title">{dict.ai.title}</h2>
    </div>

    <div class="ai-section__grid">
      {
        dict.ai.cards.map((card, i) => (
          <div class="glass-card ai-section__card reveal">
            <span class="ai-section__icon" set:html={ui[icons[i]]} />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ai-section {
    background: var(--bg-1);
  }

  .ai-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }

  .ai-section__card {
    padding: 1.8rem;
  }

  .ai-section__icon {
    display: inline-flex;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0.65rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: var(--gradient);
    color: #06070c;
  }

  .ai-section__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .ai-section__card h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .ai-section__card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  @media (max-width: 56.25rem) {
    .ai-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
