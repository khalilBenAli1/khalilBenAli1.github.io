---
import SectionHeading from "./SectionHeading.astro";
import { ui } from "../lib/icons";
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const icons = ["brain-circuit", "shield-check"];
---

<section
  class="section section--tight ai-section"
  id="ai"
  aria-labelledby="ai-title"
>
  <div class="container">
    <SectionHeading
      index="02"
      eyebrow={dict.ai.eyebrow}
      title={dict.ai.title}
      titleId="ai-title"
    />

    <div class="ai-section__grid dim-siblings" data-reveal-group>
      {
        dict.ai.cards.map((card, i) => (
          <div class="card-v3 ai-section__card" data-reveal="fade">
            <span class="ai-section__icon" set:html={ui[icons[i]]} />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ai-section {
    background: var(--bg-1);
  }

  /* Asymmetric on purpose: two equal cards read as a template. */
  .ai-section__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 1.4rem;
  }

  .ai-section__card {
    padding: 1.8rem;
  }

  .ai-section__icon {
    display: inline-flex;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0.65rem;
    margin-bottom: 1.1rem;
    /* D1: the violet→sky gradient does not fill shapes any more. */
    border: 1px solid var(--border-accent);
    border-radius: var(--r-btn);
    background: rgba(124, 92, 255, 0.12);
    color: var(--violet-soft);
  }

  .ai-section__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .ai-section__card h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ai-section__card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  @media (max-width: 56.25rem) {
    .ai-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
