---
import { ui } from "../lib/icons";

const cards = [
  {
    icon: "brain-circuit",
    title: "Shipped features",
    body: "Call transcription & summaries, LLM adjudication with deterministic gates, LangGraph agents spanning seven systems, on-device CLIP vision, RAG with pgvector and Copilot connectors.",
  },
  {
    icon: "shield-check",
    title: "Built to not break",
    body: "Provider-agnostic interfaces, graceful degradation, hardened LLM clients with timeouts and bounded retries, full token, latency and cost observability.",
  },
  {
    icon: "workflow",
    title: "AI-native workflow",
    body: "Daily multi-agent engineering: an orchestrator model plans and reviews, executor models implement, verification gates everything. This site was built exactly that way.",
  },
];

const logLines = [
  ["plan", "architecture + design system approved"],
  ["delegate", "implementation → executor model"],
  ["verify", "4 viewports · console clean · one-page CV"],
  ["ship", "khalilbenali1.github.io — live"],
];
---

<section class="section ai-section" id="ai" aria-labelledby="ai-title">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">AI Engineering</p>
      <h2 class="section-title" id="ai-title">
        AI in production, <span class="gradient-text">not in demos.</span>
      </h2>
    </div>

    <div class="ai-section__grid">
      {
        cards.map((card) => (
          <div class="glass-card ai-section__card reveal">
            <span class="ai-section__icon" set:html={ui[card.icon]} />
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </div>
        ))
      }
    </div>

    <div class="ai-section__terminal glass-card reveal" aria-hidden="true">
      {
        logLines.map(([verb, rest], i) => (
          <p class:list={[{ "is-last": i === logLines.length - 1 }]}>
            <span class="ai-section__prompt">▸</span>
            <span class="ai-section__verb">{verb}</span>
            {rest}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ai-section {
    background: var(--bg-1);
  }

  .ai-section__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
    margin-bottom: 1.4rem;
  }

  .ai-section__card {
    padding: 1.8rem;
  }

  .ai-section__icon {
    display: inline-flex;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0.65rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: var(--gradient);
    color: #06070c;
  }

  .ai-section__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .ai-section__card h3 {
    margin-bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .ai-section__card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  .ai-section__terminal {
    padding: 1.4rem 1.7rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 2;
  }

  .ai-section__terminal p {
    margin: 0;
    color: var(--muted);
  }

  .ai-section__prompt {
    margin-right: 0.65rem;
    color: var(--violet);
  }

  .ai-section__verb {
    display: inline-block;
    min-width: 6.5ch;
    margin-right: 0.5rem;
    color: var(--text);
    font-weight: 500;
  }

  .ai-section__terminal p.is-last::after {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35rem;
    vertical-align: text-bottom;
    background: var(--sky);
    animation: caret 1.1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 56.25rem) {
    .ai-section__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
