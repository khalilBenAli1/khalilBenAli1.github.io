---
import SectionHeading from "./SectionHeading.astro";
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading
      index="03"
      eyebrow={dict.experience.eyebrow}
      title={dict.experience.title}
      titleId="experience-title"
    />

    {/*
      data-reveal="lines" must never wrap the role heading: SplitText rebuilds
      the subtree as block-level line boxes, which drops the h3 out of the
      accessible tree and glues role, separator and company into one string.
      The entry fades as a whole; only the note — plain prose — gets split.
    */}
    <ol class="timeline">
      {
        dict.experience.entries.map((e) => (
          <li class="timeline__entry" data-reveal="fade">
            <span class="timeline__node" aria-hidden="true" />
            <div class="timeline__row">
              {/*
                The explicit {" "} are load-bearing. Astro collapses the
                whitespace around an expression, and the em dash is aria-hidden —
                with nothing between them the accessible name came out as
                "…AI EngineernBold". CSS padding cannot fix a name.
              */}
              <h3 class="timeline__role">
                {e.role}
                {" "}
                <span class="timeline__sep" aria-hidden="true">—</span>
                {" "}
                <span class="timeline__company">{e.company}</span>
              </h3>
              <p class="timeline__period">{e.period}</p>
            </div>
            <p class="timeline__note" data-reveal="lines">{e.note}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 2.4rem;
    max-width: 46rem;
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 7px;
    width: 2px;
    background: linear-gradient(180deg, #7c5cff, #38bdf8);
    opacity: 0.5;
  }

  .timeline__entry {
    position: relative;
  }

  .timeline__node {
    position: absolute;
    top: 7px;
    left: -2rem;
    width: 16px;
    height: 16px;
    border: 3px solid var(--bg-0);
    border-radius: 50%;
    background: var(--violet);
    box-shadow: 0 0 12px rgba(124, 92, 255, 0.8);
  }

  /* role — company on the left, period right-aligned in mono: the meta row
     form lifted from the benchmark's experience list. */
  .timeline__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    margin-bottom: 0.45rem;
  }

  .timeline__role {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  /* Real spaces sit on both sides now (see the h3 above), so this only tops up
     the optical gap around a full-width em dash. */
  .timeline__sep {
    padding-inline: 0.12rem;
    color: var(--faint);
  }

  .timeline__company {
    color: var(--violet-soft);
  }

  .timeline__period {
    margin: 0 0 0 auto;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .timeline__note {
    margin: 0;
    max-width: 48ch;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  @media (max-width: 34rem) {
    .timeline__period {
      margin-left: 0;
    }
  }
</style>
