---
const rotatingWords = [
  'AI copilots',
  'Teams platforms',
  'brand experiences',
  'desktop tools',
  'audio engines',
];
---

<header class="hero" data-hero>
  <div class="hero__inner">
    <p class="hero__eyebrow" data-hero-eyebrow>
      KHALIL BEN ALI · FULL-STACK &amp; AI ENGINEER
    </p>

    <h1 class="hero__title">
      <span class="hero__line" data-hero-line>
        I build
        <span class="hero__word-slot">
          <span
            class="hero__word"
            data-hero-word
            data-words={JSON.stringify(rotatingWords)}
            aria-live="off"
          >
            AI copilots
          </span>
        </span>
      </span>
      <span class="hero__line" data-hero-line>that ship.</span>
    </h1>

    <p class="hero__sub" data-hero-sub>
      Five years, five stacks, two alphabets. Primary engineer on an AI
      operations platform for a US financial firm, sole developer of an AI
      brand experience for one of Europe's biggest coffee brands — and a few
      audio engines for fun.
    </p>

    <div class="hero__foot" data-hero-meta>
      <div class="hero__meta" aria-label="Location and availability">
        <p>FAENZA, ITALY · CET</p>
        <p>NOW: nBold — Teams &amp; AI platforms</p>
        <p>OPEN TO INTERESTING PROBLEMS</p>
      </div>

      <div class="hero__actions">
        <a class="hero__cta hero__cta--ghost" href="#selected-work">
          See the work ↓
        </a>
        <a
          class="hero__cta hero__cta--resume"
          href="/KhalilBenAli-CV.pdf"
          data-magnetic
        >
          Download résumé
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    min-height: min(880px, 100svh);
    display: grid;
    align-items: center;
    padding-block: clamp(112px, 15vh, 176px) clamp(64px, 10vh, 112px);
    overflow: clip;
  }

  .hero__inner {
    width: min(
      calc(100% - var(--gutter) - var(--gutter)),
      var(--container)
    );
    margin-inline: auto;
  }

  .hero__eyebrow,
  .hero__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.82rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.055em;
  }

  .hero__eyebrow {
    color: var(--cobalt);
    margin-block-end: clamp(20px, 4vw, 40px);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 7.5rem);
    font-weight: 650;
    line-height: 0.86;
    letter-spacing: -0.055em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__word-slot {
    display: inline-block;
    min-width: 15ch;
    margin-left: 0.24em;
    color: var(--cobalt);
  }

  .hero__word {
    display: inline-block;
    --hero-wdth: 100;
    font-variation-settings:
      "wght" 650,
      "wdth" var(--hero-wdth),
      "opsz" 48;
    will-change: font-variation-settings;
  }

  .hero__sub {
    max-width: 850px;
    margin: clamp(32px, 5vw, 56px) 0 0;
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    line-height: 1.58;
  }

  .hero__foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-block-start: clamp(32px, 6vw, 64px);
  }

  .hero__meta {
    display: grid;
    gap: 2px;
  }

  .hero__meta p {
    margin: 0;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border: 1px solid var(--cobalt);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .hero__cta--ghost {
    color: var(--cobalt);
  }

  .hero__cta--ghost:hover {
    background: var(--tint);
  }

  .hero__cta--resume {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--ink);
  }

  .hero__cta--resume:hover {
    border-color: var(--ink);
  }

  .hero__cta:focus-visible {
    outline: 3px solid var(--cobalt);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }

    .hero__foot {
      align-items: start;
      flex-direction: column;
    }
  }

  @media (max-width: 419px) {
    .hero__title {
      font-size: clamp(1.72rem, 7.8vw, 2.05rem);
      letter-spacing: -0.04em;
    }

    .hero__word-slot {
      min-width: 14.75ch;
    }

    .hero__actions,
    .hero__cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word {
      will-change: auto;
    }

    .hero__cta {
      transition: none;
    }
  }
</style>
