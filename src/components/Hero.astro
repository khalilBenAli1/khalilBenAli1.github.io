---
import { ui, tech } from "../lib/icons";
import { cvFile, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<section class="hero" id="top">
  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow" data-hero-eyebrow>
        {dict.hero.eyebrow}
      </p>
      <h1 class="hero__title" data-hero-title>
        <span class="hero__sheen">Khalil Ben Ali</span>
      </h1>
      <p class="hero__lead" data-hero-lead>
        {dict.hero.lead}
      </p>
      <div class="hero__ctas" data-hero-ctas>
        <a class="btn btn--primary" href="#work" data-magnetic>
          {dict.hero.viewWork}
          <span set:html={ui["arrow-down"]} />
        </a>
        <a class="btn btn--ghost" href={cvFile(locale)} download data-magnetic>
          <span set:html={ui.download} />
          {dict.hero.downloadCv}
        </a>
      </div>
      <div class="hero__social" data-hero-social>
        <a
          class="icon-btn"
          href="https://github.com/khalilBenAli1"
          aria-label="GitHub"
          set:html={ui.github}
        />
        <a
          class="icon-btn"
          href="https://linkedin.com/in/khalil-ben-ali"
          aria-label="LinkedIn"
          set:html={ui.linkedin}
        />
        <a
          class="icon-btn"
          href="mailto:khalil.benali16121@gmail.com"
          aria-label="Email"
          set:html={ui.mail}
        />
      </div>
    </div>

    <div class="hero__visual" data-hero-visual>
      <div class="hero__photo-wrap" data-tilt>
        <img
          class="hero__photo"
          src="/khalil.jpg"
          alt={dict.resume.photoAlt}
          width="640"
          height="640"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <span class="hero__chip hero__chip--1" data-hero-chip>
        <span class="hero__chip-icon" set:html={tech.TypeScript} />
        TypeScript
      </span>
      <span class="hero__chip hero__chip--2" data-hero-chip>
        <span class="hero__chip-icon" set:html={ui["brain-circuit"]} />
        AI Engineering
      </span>
      <span class="hero__chip hero__chip--3" data-hero-chip>
        <span class="hero__chip-icon" set:html={tech[".NET 9"]} />
        .NET
      </span>
    </div>
  </div>

  <a class="hero__scroll-cue" href="#work" data-scroll-cue>
    <span set:html={ui.mouse} />
    <span>{dict.hero.scroll}</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 92vh;
    padding-top: calc(var(--nav-h) + 2rem);
    padding-bottom: 3rem;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .hero__title {
    margin-block: 1.1rem 1.2rem;
    font-family: var(--font-display);
    font-size: var(--h1);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .hero__sheen {
    background: linear-gradient(
      110deg,
      #f2f4fa 0%,
      #f2f4fa 38%,
      #9d8cff 48%,
      #38bdf8 54%,
      #f2f4fa 64%,
      #f2f4fa 100%
    );
    background-size: 220% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: sheen 7s ease-in-out infinite;
  }

  @keyframes sheen {
    0%,
    100% {
      background-position: 110% 0;
    }
    50% {
      background-position: -10% 0;
    }
  }

  .hero__lead {
    max-width: 52ch;
    margin-bottom: 2rem;
    color: var(--muted);
    font-size: 1.22rem;
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.6rem;
  }

  .hero__social {
    display: flex;
    gap: 0.65rem;
  }

  .hero__visual {
    position: relative;
    justify-self: center;
  }

  .hero__photo-wrap {
    position: relative;
    width: clamp(250px, 26vw, 350px);
    padding: 3px;
    border-radius: var(--radius-lg);
    background: var(--gradient);
    box-shadow: var(--glow-violet), var(--glow-sky);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 3px);
  }

  .hero__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    background: rgba(18, 21, 34, 0.85);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.45);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
    animation: float 6s ease-in-out infinite;
  }

  .hero__chip-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    color: var(--violet-soft);
  }

  .hero__chip-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .hero__chip--1 {
    top: 6%;
    left: -3.4rem;
  }

  .hero__chip--2 {
    right: -2.6rem;
    bottom: 24%;
    animation-delay: -2s;
  }

  .hero__chip--3 {
    bottom: -1.1rem;
    left: 12%;
    animation-delay: -4s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }

  .hero__scroll-cue {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    transform: translateX(-50%);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.4s ease;
  }

  .hero__scroll-cue :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    animation: float 2.4s ease-in-out infinite;
  }

  @media (max-width: 56.25rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
      margin-top: 0.5rem;
    }

    .hero__photo-wrap {
      width: clamp(200px, 46vw, 280px);
    }

    .hero__chip--1 {
      left: -1.2rem;
    }

    .hero__chip--2 {
      right: -0.8rem;
    }

    .hero__scroll-cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sheen {
      animation: none;
      background: none;
      color: var(--text);
    }

    .hero__chip,
    .hero__scroll-cue :global(svg) {
      animation: none;
    }
  }
</style>
