---
import { marqueeItems, tech } from "../lib/icons";
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <ul class="marquee__list">
          {marqueeItems.map((name) => (
            <li>
              {tech[name] && <span class="marquee__icon" set:html={tech[name]} />}
              <span>{name}</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: 1.2rem;
    border-block: 1px solid var(--border);
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 12%,
      #000 88%,
      transparent
    );
  }

  /* motion/marquee.ts takes this over (inline `animation: none`) and drives
     xPercent + skewX from scroll velocity, including the hover pause. The
     keyframes below stay as the no-JS and reduced-motion fallback. */
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  .marquee__list {
    display: flex;
    gap: 2.6rem;
    margin: 0;
    padding: 0 1.3rem;
    list-style: none;
  }

  .marquee__list li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .marquee__icon {
    display: inline-flex;
    width: 1.3rem;
    height: 1.3rem;
    color: rgba(242, 244, 250, 0.72);
  }

  .marquee__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
