---
import SectionHeading from "./SectionHeading.astro";
import { tech, ui } from "../lib/icons";
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const groups: { icon: string; title: string; items: string[] }[] = [
  {
    icon: "monitor",
    title: dict.skills.groups.frontend,
    items: ["TypeScript", "React", "Next.js", "Astro", "React Native", "Tailwind", "GSAP", "WebGL"],
  },
  {
    icon: "server",
    title: dict.skills.groups.backend,
    items: ["Node.js", "NestJS", "Express", "PostgreSQL", "MongoDB", "Redis", "RabbitMQ", "Socket.IO"],
  },
  {
    icon: "brain-circuit",
    title: dict.skills.groups.ailtm,
    items: ["Azure OpenAI", "Gemini", "LangChain / LangGraph", "RAG · pgvector", "transformers.js"],
  },
  {
    icon: "cpu",
    title: dict.skills.groups.native,
    items: ["C#", ".NET 9", "WPF", "C++20", "JUCE", "CMake", "SQLite"],
  },
  {
    icon: "wrench",
    title: dict.skills.groups.platform,
    items: ["Microsoft Graph", "Microsoft Teams", "Salesforce", "Azure", "Docker", "GitHub Actions", "Vercel", "Git"],
  },
];
---

<section
  class="section section--tight"
  id="skills"
  aria-labelledby="skills-title"
>
  <div class="container">
    <SectionHeading
      index="04"
      eyebrow={dict.skills.eyebrow}
      title={dict.skills.title}
      titleId="skills-title"
    />

    <div class="skills__grid dim-siblings" data-reveal-group>
      {
        groups.map((group) => (
          <div class="card-v3 skills__card" data-reveal="fade">
            <h3>
              <span class="skills__icon" set:html={ui[group.icon]} />
              {group.title}
            </h3>
            <div class="skills__chips">
              {group.items.map((item) => (
                <span class="chip">
                  {tech[item] && (
                    <span class="skills__chip-icon" set:html={tech[item]} />
                  )}
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.4rem;
  }

  .skills__card {
    padding: 1.6rem;
  }

  .skills__card h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .skills__icon {
    display: inline-flex;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0.4rem;
    border: 1px solid var(--border-accent);
    border-radius: var(--r-chip);
    background: rgba(124, 92, 255, 0.12);
    color: var(--violet-soft);
  }

  .skills__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .skills__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .skills__chips .chip {
    border-radius: var(--r-chip);
  }

  .skills__chip-icon {
    display: inline-flex;
    width: 0.9rem;
    height: 0.9rem;
    color: rgba(242, 244, 250, 0.75);
  }

  .skills__chip-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
