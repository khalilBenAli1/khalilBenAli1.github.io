---
const groups = [
  {
    label: 'Frontend',
    items: [
      'TypeScript',
      'React 19',
      'Next.js 15',
      'React Native',
      'Tailwind v4',
      'MUI',
      'GSAP',
      'WebGL',
      'Zustand',
      'React Query',
    ],
  },
  {
    label: 'Backend',
    items: [
      'Node.js',
      'NestJS',
      'Express',
      'PostgreSQL',
      'MongoDB',
      'Redis/BullMQ',
      'Socket.IO',
      'Sequelize/Drizzle/Prisma',
      'REST/OpenAPI',
    ],
  },
  {
    label: 'AI & LLM',
    items: [
      'Azure OpenAI',
      'Gemini',
      'LangChain/LangGraph',
      'RAG (pgvector, Ollama)',
      'transformers.js/ONNX',
      'prompt & eval design',
      'LLM observability (PostHog)',
    ],
  },
  {
    label: 'Native & Systems',
    items: [
      'C# /.NET 9',
      'WPF',
      'C++20',
      'JUCE',
      'CMake',
      'Protobuf',
      'SQLite',
    ],
  },
  {
    label: 'Platform',
    items: [
      'Microsoft Graph',
      'Teams apps/SSO',
      'Salesforce',
      'Azure',
      'Docker',
      'GitHub Actions',
      'Vercel',
      'gitleaks/HMAC hardening',
    ],
  },
  {
    label: 'Human',
    items: [
      'Arabic (native)',
      'English (professional)',
      'French (A2–B1)',
      'Italian (A2)',
    ],
  },
];
---

<section class="skills" id="skills" aria-labelledby="skills-title" data-section>
  <div class="skills__inner">
    <h2 id="skills-title">Skills</h2>

    <div class="skills__groups">
      {groups.map((group) => (
        <section class="skills__group" aria-labelledby={`skills-${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
          <h3 id={`skills-${group.label.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
            {group.label}
          </h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    padding-block: clamp(80px, 12vw, 152px);
    background: var(--tint);
  }

  .skills__inner {
    width: min(
      calc(100% - var(--gutter) - var(--gutter)),
      var(--container)
    );
    margin-inline: auto;
  }

  .skills h2 {
    margin: 0 0 clamp(48px, 7vw, 80px);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .skills__groups {
    display: grid;
    gap: 32px;
  }

  .skills__group {
    display: grid;
    grid-template-columns: minmax(120px, 0.22fr) 1fr;
    gap: 24px;
    padding-block-end: 28px;
    border-block-end: 1px solid var(--cobalt);
  }

  .skills__group:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  .skills__group h3 {
    margin: 7px 0 0;
    color: var(--cobalt);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.065em;
    text-transform: uppercase;
  }

  .skills__group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills__group li {
    padding: 7px 9px;
    border: 1px solid var(--cobalt-2);
    border-radius: 3px;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1;
  }

  @media (max-width: 620px) {
    .skills__group {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
