---
const items = [
  {
    title: 'Assurances BIAT KB',
    description:
      'explainable RAG chatbot for internal regulations: pgvector + Ollama, cited answers (doc/chapter/article/page), RBAC + audit trail.',
    stack: 'NestJS · pgvector · Ollama',
  },
  {
    title: 'AI Chat Companion',
    description:
      'multi-tenant support inbox unifying Instagram + WhatsApp with GPT reply suggestions.',
    stack: 'NestJS · Prisma · Next.js 14 · Socket.io',
  },
  {
    title: 'Earlier',
    description:
      'AR tourism app, job platform, e-commerce & chat apps at Tynass IT and SolvR (2019–2023).',
    stack: 'React Native · Firebase · MobX',
  },
];
---

<section class="more-work" id="more-work" aria-labelledby="more-work-title" data-section>
  <div class="more-work__inner">
    <h2 id="more-work-title">More work</h2>

    <ul class="more-work__list">
      {items.map((item) => (
        <li>
          <article>
            <p>
              <strong>{item.title}</strong>
              <span aria-hidden="true"> — </span>
              {item.description}
            </p>
            <p class="more-work__stack">{item.stack}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .more-work {
    padding-block: clamp(80px, 12vw, 152px);
  }

  .more-work__inner {
    width: min(
      calc(100% - var(--gutter) - var(--gutter)),
      var(--container)
    );
    margin-inline: auto;
  }

  .more-work h2 {
    margin: 0 0 clamp(40px, 6vw, 64px);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 650;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .more-work__list {
    margin: 0;
    padding: 0;
    border-block-start: 2px solid var(--cobalt);
    list-style: none;
  }

  .more-work__list li {
    padding-block: 26px;
    border-block-end: 1px solid var(--cobalt);
  }

  .more-work article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.35fr);
    gap: 32px;
    align-items: baseline;
  }

  .more-work p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.1vw, 0.9rem);
    line-height: 1.65;
  }

  .more-work strong {
    color: var(--cobalt);
    font-weight: 500;
  }

  .more-work__stack {
    text-align: end;
  }

  @media (max-width: 700px) {
    .more-work article {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .more-work__stack {
      color: var(--cobalt);
      text-align: start;
    }
  }
</style>
