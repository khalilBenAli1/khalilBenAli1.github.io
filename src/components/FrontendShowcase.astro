---
import { frontendProjects } from '../lib/frontend-projects';
import type { Locale } from '../lib/i18n';
interface Props { locale: Locale }
const {locale} = Astro.props;
const copy = {
  en: {eyebrow:'Front-end experiences',title:'Built to be explored.',intro:'Original interfaces across different worlds. Browse the rooms, follow the details, and try the experience for yourself.',live:'Explore the website',source:'View source',note:'Original portfolio applications. Brands and booking flows are fictional.'},
  fr: {eyebrow:'Expériences front-end',title:'À découvrir, vraiment.',intro:'Des interfaces originales dans des univers différents. Parcourez les pages, découvrez les détails et essayez chaque expérience.',live:'Explorer le site',source:'Voir le code',note:'Applications originales de portfolio. Les marques et parcours de réservation sont fictifs.'},
  it: {eyebrow:'Esperienze front-end',title:'Da esplorare, davvero.',intro:'Interfacce originali in mondi diversi. Sfoglia le pagine, scopri i dettagli e prova ogni esperienza.',live:'Esplora il sito',source:'Vedi il codice',note:'Applicazioni originali per il portfolio. Marchi e prenotazioni sono fittizi.'},
}[locale];
---
<section id="frontend" class="frontend-showcase" aria-labelledby="frontend-title">
  <header class="frontend-showcase__header"><p class="frontend-showcase__eyebrow">{copy.eyebrow}</p><h3 id="frontend-title">{copy.title}</h3><p>{copy.intro}</p></header>
  <div class:list={['frontend-showcase__grid',{'frontend-showcase__grid--single':frontendProjects.length === 1}]}>
    {frontendProjects.map((project) => <article class="frontend-demo">
      <a class="frontend-demo__preview" href={project.demo} aria-label={`${copy.live} — ${project.name}`}><div class="frontend-demo__chrome" aria-hidden="true"><span></span><span></span><span></span><small>{project.name}</small></div><img src={project.image} alt={`${project.name} — ${project.sector[locale]}`} width="1440" height="1000" loading="lazy" decoding="async" /></a>
      <div class="frontend-demo__body"><p class="frontend-demo__sector">{project.sector[locale]} <span>· {project.year}</span></p><h4>{project.name}</h4><p class="frontend-demo__description">{project.description[locale]}</p><div class="frontend-demo__technology">{project.technology.map((technology)=><span>{technology}</span>)}</div><div class="frontend-demo__links"><a href={project.demo}>{copy.live} <span aria-hidden="true">↗</span></a><a href={project.source}>{copy.source}</a></div></div>
    </article>)}
  </div><p class="frontend-showcase__note">{copy.note}</p>
</section>
<style>
.frontend-showcase{padding-block:clamp(2.5rem,5vw,4.5rem);scroll-margin-top:90px}.frontend-showcase__header{max-width:42rem;margin-bottom:2rem}.frontend-showcase__eyebrow{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.13em;text-transform:uppercase;color:var(--sky);margin-bottom:.8rem}.frontend-showcase__header h3{font-family:var(--font-display);font-size:clamp(1.9rem,3.5vw,2.8rem);font-weight:500;letter-spacing:-.04em;line-height:1.1;margin-bottom:1rem}.frontend-showcase__header>p:last-child{color:var(--muted);line-height:1.8;font-size:.95rem}.frontend-showcase__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.75rem}.frontend-demo{overflow:hidden;background:var(--card-surface);border:1px solid var(--border-accent);border-radius:var(--r-card);box-shadow:var(--shadow-dir),var(--bevel-top)}.frontend-demo__preview{display:block;background:#f5f1e8;overflow:hidden;text-decoration:none;color:#173e39}.frontend-demo__chrome{display:flex;gap:5px;padding:10px 14px;background:#e6e5da;border-bottom:1px solid #d3d6c9;align-items:center}.frontend-demo__chrome>span{width:5px;height:5px;flex:none;background:#87958b;border-radius:50%}.frontend-demo__chrome>small{font:9px var(--font-mono);letter-spacing:.08em;text-transform:uppercase;margin-left:auto}.frontend-demo__preview>img{width:100%;height:auto;aspect-ratio:1.44;object-fit:cover;object-position:top;display:block;transition:transform 700ms var(--ease-expo)}.frontend-demo__preview:hover>img{transform:scale(1.02)}.frontend-demo__body{padding:clamp(1.5rem,3vw,2.5rem);display:flex;flex-direction:column;align-items:flex-start}.frontend-demo__sector{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;color:var(--sky);margin-bottom:1rem}.frontend-demo__sector>span{color:var(--faint)}.frontend-demo__body h4{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.3rem);font-weight:500;letter-spacing:-.04em;margin:0 0 1rem}.frontend-demo__description{color:var(--muted);font-size:.95rem;line-height:1.8;margin-bottom:1.4rem}.frontend-demo__technology{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.7rem}.frontend-demo__technology>span{font-family:var(--font-mono);font-size:.63rem;border:1px solid var(--border);padding:.35rem .55rem;border-radius:var(--r-chip);color:var(--faint)}.frontend-demo__links{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;margin-top:auto}.frontend-demo__links a{font-size:.8rem;color:var(--text);text-decoration:none;border-bottom:1px solid var(--violet);padding-block:.6rem;display:flex;gap:1rem;align-items:center}.frontend-demo__links a:last-child{font-size:.72rem;color:var(--muted);border-bottom-color:var(--border)}.frontend-demo__links a:hover{color:var(--sky)}.frontend-showcase__note{font-size:.72rem;line-height:1.8;color:var(--faint);margin-top:1.4rem}.frontend-showcase__grid--single{grid-template-columns:1fr}.frontend-showcase__grid--single .frontend-demo{display:grid;grid-template-columns:1.2fr 1fr;align-items:stretch}.frontend-showcase__grid--single .frontend-demo__preview>img{height:calc(100% - 31px);object-fit:cover}.frontend-demo a:focus-visible{outline:var(--focus-ring);outline-offset:5px}@media(max-width:700px){.frontend-showcase__grid{grid-template-columns:1fr}.frontend-showcase__grid--single .frontend-demo{display:block}.frontend-showcase__grid--single .frontend-demo__preview>img{height:auto;aspect-ratio:1.44}.frontend-demo__body{padding:1.5rem}.frontend-demo__description{font-size:.9rem}.frontend-demo__links{gap:1.2rem}.frontend-demo__links a{font-size:.75rem}.frontend-showcase__note{font-size:.65rem}}@media(prefers-reduced-motion:reduce){.frontend-demo__preview>img{transition:none}}
</style>
