---
import { ui } from "../lib/icons";

export interface DNode {
  id: string;
  x: number;
  y: number;
  w: number;
  h?: number;
  icon: string;
  label: string;
  sub?: string;
  /** status LED — "processing" breathes (#9d8cff), "healthy" is static (#38bdf8) */
  led?: "processing" | "healthy";
}

export interface DEdge {
  /** "nodeId@side" where side is left|right|top|bottom */
  from: string;
  to: string;
  label?: string;
  /** optional intermediate waypoints (orthogonal routing / collector buses) */
  via?: [number, number][];
  /** false on bus feeders: only the trunk edge carries the arrowhead */
  tip?: boolean;
  /** draw an exact-width mono pill behind the label */
  pill?: boolean;
}

/** dashed hull naming an architecture tier */
export interface DZone {
  label: string;
  x: number;
  y: number;
  w: number;
  h: number;
}

interface Props {
  id: string;
  title: string;
  nodes: DNode[];
  edges: DEdge[];
  zones?: DZone[];
}

const { id, title, nodes, edges, zones = [] } = Astro.props;

const H_DEFAULT = 48;
const H_SUB = 64;

/* ---------- choreography (ms) — edges draw INTO nodes that already exist ----------
   0    plate + grid, 260 ease-out            (CSS)
   140  zones fade, dash settles, 400         (CSS)
   260 + i*70   nodes, 380 cubic(.22,1,.36,1)
   nodesEnd + i*60   edges draw, 520 cubic(.4,0,.2,1)
   edgesEnd + i*18   ports pop, 200 cubic(.34,1.56,.64,1)
   edgesEnd + 260    LEDs, 300 ease                                            */
const T_NODE = 260;
const S_NODE = 70;
const D_NODE = 380;
const S_EDGE = 60;
const D_EDGE = 520;
const S_PORT = 18;
const D_PORT = 200;
const D_LED = 300;

const nodesEnd = T_NODE + Math.max(nodes.length - 1, 0) * S_NODE + D_NODE;
const T_EDGE = nodesEnd;
const edgesEnd = T_EDGE + Math.max(edges.length - 1, 0) * S_EDGE + D_EDGE;
const T_PORT = edgesEnd;
const T_LED = edgesEnd + 260;

const LED_COLOR = { processing: "#9d8cff", healthy: "#38bdf8" } as const;

function nodeRect(n: DNode) {
  return { x: n.x, y: n.y, w: n.w, h: n.h ?? (n.sub ? H_SUB : H_DEFAULT) };
}

function nodeIdOf(ref: string): string {
  return ref.split("@")[0];
}

function anchor(ref: string): [number, number] {
  const [nid, side = "right"] = ref.split("@");
  const n = nodes.find((node) => node.id === nid);
  if (!n) throw new Error(`Diagram ${id}: unknown node "${nid}"`);
  const r = nodeRect(n);
  switch (side) {
    case "left":
      return [r.x, r.y + r.h / 2];
    case "top":
      return [r.x + r.w / 2, r.y];
    case "bottom":
      return [r.x + r.w / 2, r.y + r.h];
    default:
      return [r.x + r.w, r.y + r.h / 2];
  }
}

function edgePoints(e: DEdge): [number, number][] {
  return [anchor(e.from), ...(e.via ?? []), anchor(e.to)];
}

/** orthogonal routing with rounded elbows; r is clamped to half of each segment */
function roundedPath(pts: [number, number][], r = 10): string {
  if (pts.length < 3) {
    return pts.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join(" ");
  }
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1];
    const [cx, cy] = pts[i];
    const [nx, ny] = pts[i + 1];
    const d1 = Math.hypot(cx - px, cy - py);
    const d2 = Math.hypot(nx - cx, ny - cy);
    if (d1 === 0 || d2 === 0) {
      d += ` L${cx} ${cy}`;
      continue;
    }
    const r1 = Math.min(r, d1 / 2);
    const r2 = Math.min(r, d2 / 2);
    const ax = cx - ((cx - px) / d1) * r1;
    const ay = cy - ((cy - py) / d1) * r1;
    const bx = cx + ((nx - cx) / d2) * r2;
    const by = cy + ((ny - cy) / d2) * r2;
    d += ` L${ax.toFixed(2)} ${ay.toFixed(2)} Q${cx} ${cy} ${bx.toFixed(2)} ${by.toFixed(2)}`;
  }
  const [lx, ly] = pts[pts.length - 1];
  return `${d} L${lx} ${ly}`;
}

function edgeLabelPos(e: DEdge): [number, number] {
  const pts = edgePoints(e);
  const mid = Math.floor((pts.length - 1) / 2);
  const [x1, y1] = pts[mid];
  const [x2, y2] = pts[mid + 1];
  return [(x1 + x2) / 2, (y1 + y2) / 2 - 7];
}

/** strip the outer <svg> wrapper from a lucide raw icon, keep inner markup */
function inner(svg: string): string {
  return svg.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
}

/* ---------- edges ---------- */
const wires = edges.map((e, i) => ({
  edge: e,
  i,
  pid: `${id}-e${i}`,
  d: roundedPath(edgePoints(e)),
  from: nodeIdOf(e.from),
  to: nodeIdOf(e.to),
  delay: T_EDGE + i * S_EDGE,
}));

/* ---------- ports: one socket per node anchor, deduped (hub@left is hit 5×) ---------- */
const ports: { x: number; y: number; node: string }[] = [];
const seen = new Set<string>();
for (const e of edges) {
  for (const ref of [e.from, e.to]) {
    const [x, y] = anchor(ref);
    const key = `${Math.round(x)}:${Math.round(y)}`;
    if (seen.has(key)) continue;
    seen.add(key);
    ports.push({ x, y, node: nodeIdOf(ref) });
  }
}

const introMs = Math.max(T_LED + D_LED, T_PORT + ports.length * S_PORT + D_PORT);

/* ---------- packets: SMIL animateMotion + mpath + comet trail ----------
   Rendered as raw markup so `xlink:href` (older Safari) survives, and so the
   30 path strings are never duplicated into animation attributes.
   Packets begin at SMIL t=0 — the clock is paused until the diagram is in view,
   so t is "visible time". The layer is CSS-hidden for the length of the intro
   instead of delaying `begin`: an element whose animateMotion has not started
   yet renders at (0,0), which would park a bright dot in the plate corner.   */
const packetsMarkup = wires
  .map(({ pid, i, from, to }) => {
    const base = i * 0.26;
    const dot = (r: number, o: number, begin: number) =>
      `<circle r="${r}" fill="#cfe4ff" opacity="${o}">` +
      `<animateMotion dur="3.2s" begin="${begin.toFixed(2)}s" repeatCount="indefinite"` +
      ` calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines="0.42 0 0.58 1">` +
      `<mpath href="#${pid}" xlink:href="#${pid}"/></animateMotion></circle>`;
    return (
      `<g class="diagram__packet" data-dim data-from="${from}" data-to="${to}">` +
      dot(1.3, 0.25, base - 0.14) +
      dot(1.9, 0.5, base - 0.07) +
      dot(2.6, 0.95, base) +
      `</g>`
    );
  })
  .join("");

/* ---------- accessible description ----------
   `aria-label` (the title) says what the diagram is; this says what is in it, so
   a screen-reader user gets the component inventory without having to infer it
   from a prose sentence. Assembled from the zone and node labels already on the
   page — it can never claim anything the picture does not show. English only,
   like every other label in these diagrams (they are product/technology names). */
const descText = [
  zones.length > 0 ? `Tiers: ${zones.map((z) => z.label).join(", ")}.` : "",
  `Components: ${nodes.map((n) => n.label).join(", ")}.`,
]
  .filter(Boolean)
  .join(" ");

/* ---------- blueprint register marks on the field corners ---------- */
const marks = [
  "M10 19 L10 13 Q10 10 13 10 L19 10",
  "M630 19 L630 13 Q630 10 627 10 L621 10",
  "M10 381 L10 387 Q10 390 13 390 L19 390",
  "M630 381 L630 387 Q630 390 627 390 L621 390",
];
---

<svg
  class="diagram"
  data-diagram
  data-intro-ms={introMs}
  viewBox="0 0 640 400"
  role="img"
  aria-label={title}
  aria-describedby={`${id}-desc`}
>
  <title>{title}</title>
  <desc id={`${id}-desc`}>{descText}</desc>
  <defs>
    {/* rect-only gradients: objectBoundingBox is safe (nonzero w/h) */}
    <linearGradient id={`${id}-surface`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1c2134"></stop>
      <stop offset="0.55" stop-color="#161a28"></stop>
      <stop offset="1" stop-color="#12151f"></stop>
    </linearGradient>

    {/* directional rim: bright where the light hits, fading to nothing */}
    <linearGradient id={`${id}-rim`} x1="0" y1="0" x2="0.65" y2="1">
      <stop offset="0" stop-color="#b9aeff" stop-opacity="0.6"></stop>
      <stop offset="0.45" stop-color="#7c5cff" stop-opacity="0.24"></stop>
      <stop offset="1" stop-color="#7c5cff" stop-opacity="0.05"></stop>
    </linearGradient>

    <linearGradient id={`${id}-chip`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7c5cff" stop-opacity="0.26"></stop>
      <stop offset="1" stop-color="#38bdf8" stop-opacity="0.14"></stop>
    </linearGradient>

    {/* wires sample the light field by position — userSpaceOnUse is mandatory:
        axis-aligned edges have a degenerate bbox and would drop the paint server */}
    <linearGradient
      id={`${id}-wire`}
      gradientUnits="userSpaceOnUse"
      x1="0"
      y1="400"
      x2="640"
      y2="0"
    >
      <stop offset="0" stop-color="#7c5cff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#38bdf8" stop-opacity="0.55"></stop>
    </linearGradient>

    <pattern
      id={`${id}-dots`}
      width="16"
      height="16"
      patternUnits="userSpaceOnUse"
    >
      <circle cx="1" cy="1" r="1" fill="#7c5cff" fill-opacity="0.11"></circle>
    </pattern>

    <radialGradient id={`${id}-vig`} cx="0.5" cy="0.45" r="0.72">
      <stop offset="0" stop-color="#fff" stop-opacity="1"></stop>
      <stop offset="0.65" stop-color="#fff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>

    <mask id={`${id}-gm`}>
      <rect width="640" height="400" fill={`url(#${id}-vig)`}></rect>
    </mask>

    {/* chevron, not a filled triangle */}
    <marker
      id={`${id}-tip`}
      viewBox="0 0 10 10"
      refX="7.5"
      refY="5"
      markerWidth="6"
      markerHeight="6"
      orient="auto-start-reverse"
    >
      <path
        d="M2.5 2 L7.5 5 L2.5 8"
        fill="none"
        stroke="#6f7ba3"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </marker>

    {/* one ambient near-black shadow for the whole rect layer; generous region */}
    <filter
      id={`${id}-lift`}
      x="-20%"
      y="-20%"
      width="140%"
      height="140%"
      filterUnits="objectBoundingBox"
      color-interpolation-filters="sRGB"
    >
      <feDropShadow
        dx="0"
        dy="5"
        stdDeviation="6"
        flood-color="#08090a"
        flood-opacity="0.7"></feDropShadow>
    </filter>
  </defs>

  {/* L0 — plate */}
  <rect
    class="diagram__field"
    x="0.5"
    y="0.5"
    width="639"
    height="399"
    rx="16"
    fill="#0a0c14"
    stroke="#7c5cff"
    stroke-opacity="0.1"
  />

  {/* L1 — dot grid, vignette-masked so it dies before the plate edge */}
  <rect
    class="diagram__grid"
    width="640"
    height="400"
    fill={`url(#${id}-dots)`}
    mask={`url(#${id}-gm)`}
  />

  <g class="diagram__frame">
    {marks.map((d) => <path d={d} fill="none" stroke="#7c5cff" stroke-opacity="0.4" stroke-width="1.25" />)}
  </g>

  {/* L2 — tier containers */}
  {
    zones.length > 0 && (
      <g class="diagram__zones">
        {zones.map((z) => (
          <g class="diagram__zone">
            <rect
              class="diagram__zone-rect"
              x={z.x}
              y={z.y}
              width={z.w}
              height={z.h}
              rx="14"
              fill="#7c5cff"
              fill-opacity="0.028"
              stroke="#7c5cff"
              stroke-opacity="0.2"
              stroke-width="1"
              stroke-dasharray="5 5"
            />
            <text class="diagram__zone-label" x={z.x + 12} y={z.y - 6}>
              {z.label}
            </text>
          </g>
        ))}
      </g>
    )
  }

  {/* L3 — edges */}
  <g class="diagram__edges">
    {
      wires.map(({ edge: e, pid, d, from, to, delay }) => {
        const [lx, ly] = edgeLabelPos(e);
        const pw = e.label ? e.label.length * 6 + 14 : 0;
        return (
          <g
            class="diagram__edge-group"
            data-dim
            data-from={from}
            data-to={to}
            style={`--edge-delay:${delay}ms`}
          >
            <path
              id={pid}
              class="diagram__edge"
              data-edge
              d={d}
              pathLength="1"
              stroke={`url(#${id}-wire)`}
              marker-end={e.tip === false ? undefined : `url(#${id}-tip)`}
            />
            {e.label && e.pill && (
              <rect
                class="diagram__edge-pill"
                x={lx - pw / 2}
                y={ly - 11}
                width={pw}
                height="15"
                rx="7.5"
              />
            )}
            {e.label && (
              <text class="diagram__edge-label" x={lx} y={ly} text-anchor="middle">
                {e.label}
              </text>
            )}
          </g>
        );
      })
    }
  </g>

  {/* L4a — node plates only, one filter region for the whole layer */}
  <g class="diagram__plates" filter={`url(#${id}-lift)`}>
    {
      nodes.map((n, i) => {
        const r = nodeRect(n);
        return (
          <rect
            class="diagram__plate"
            data-dim
            data-node={n.id}
            x={r.x}
            y={r.y}
            width={r.w}
            height={r.h}
            rx="12"
            fill={`url(#${id}-surface)`}
            stroke={`url(#${id}-rim)`}
            stroke-width="1"
            style={`--node-delay:${T_NODE + i * S_NODE}ms;--ox:${r.x + r.w / 2}px;--oy:${r.y + r.h / 2}px`}
          />
        );
      })
    }
  </g>

  {/* L4b — unfiltered: hairline, chip, icon, text, LED */}
  <g class="diagram__nodes">
    {
      nodes.map((n, i) => {
        const r = nodeRect(n);
        const cy = r.y + r.h / 2;
        const iconSvg = ui[n.icon];
        const textX = r.x + (iconSvg ? 45 : 14);
        return (
          <g
            class="diagram__node"
            data-dim
            data-node={n.id}
            style={`--node-delay:${T_NODE + i * S_NODE}ms;--ox:${r.x + r.w / 2}px;--oy:${cy}px`}
          >
            <line
              class="diagram__spec"
              x1={r.x + 12}
              y1={r.y + 1}
              x2={r.x + r.w - 12}
              y2={r.y + 1}
            />
            {iconSvg && (
              <Fragment>
                <rect
                  class="diagram__chip"
                  x={r.x + 11}
                  y={cy - 12}
                  width="24"
                  height="24"
                  rx="7"
                  fill={`url(#${id}-chip)`}
                />
                <g
                  class="diagram__icon"
                  transform={`translate(${(r.x + 15.08).toFixed(2)}, ${(cy - 7.92).toFixed(2)}) scale(0.66)`}
                  set:html={inner(iconSvg)}
                />
              </Fragment>
            )}
            {n.led && (
              <g class="diagram__led" style={`--led-delay:${T_LED}ms`}>
                <g class={n.led === "processing" ? "diagram__led-pulse" : undefined}>
                  <circle
                    cx={r.x + r.w - 11}
                    cy={r.y + 11}
                    r="5"
                    fill={LED_COLOR[n.led]}
                    fill-opacity="0.16"
                  />
                  <circle cx={r.x + r.w - 11} cy={r.y + 11} r="2.5" fill={LED_COLOR[n.led]} />
                  {n.led === "processing" && (
                    <animate
                      attributeName="opacity"
                      values="0.55;1;0.55"
                      dur="2.6s"
                      begin={`${(T_LED + D_LED) / 1000}s`}
                      calcMode="spline"
                      keyTimes="0;0.5;1"
                      keySplines="0.4 0 0.6 1;0.4 0 0.6 1"
                      repeatCount="indefinite"
                    />
                  )}
                </g>
              </g>
            )}
            <text class="diagram__label" x={textX} y={n.sub ? cy - 4 : cy + 4.5}>
              {n.label}
            </text>
            {n.sub && (
              <text class="diagram__sub" x={textX} y={cy + 14}>
                {n.sub}
              </text>
            )}
          </g>
        );
      })
    }
  </g>

  {/* L5 — sockets where wires meet plates */}
  <g class="diagram__ports">
    {
      ports.map((p, i) => (
        <circle
          class="diagram__port"
          data-dim
          data-node={p.node}
          cx={p.x}
          cy={p.y}
          r="2.5"
          fill="#06070c"
          stroke={`url(#${id}-wire)`}
          stroke-width="1.25"
          style={`--port-delay:${T_PORT + i * S_PORT}ms`}
        />
      ))
    }
  </g>

  {/* L5 — packets (declarative, gated by pause/unpauseAnimations) */}
  <g
    class="diagram__packets"
    style={`--packet-delay:${introMs}ms`}
    set:html={packetsMarkup}
  />

  {/* hit targets for focus mode; the rest of the svg is pointer-transparent */}
  <g class="diagram__hits">
    {
      nodes.map((n) => {
        const r = nodeRect(n);
        return (
          <rect
            class="diagram__hit"
            data-hit={n.id}
            x={r.x - 4}
            y={r.y - 4}
            width={r.w + 8}
            height={r.h + 8}
            rx="14"
          />
        );
      })
    }
  </g>
</svg>

<style>
  .diagram {
    width: 100%;
    height: auto;
    overflow: visible;
    /* only the hit rects take pointer events; card tilt still receives moves */
    pointer-events: none;
  }

  /* ---------- layers 0–2 ---------- */
  .diagram__field,
  .diagram__grid,
  .diagram__frame {
    opacity: 0;
    transition: opacity 260ms ease-out;
  }

  .diagram__zone {
    opacity: 0;
    transition: opacity 400ms ease-out 140ms;
  }

  .diagram__zone-rect {
    stroke-dashoffset: 10;
    transition: stroke-dashoffset 400ms ease-out 140ms;
  }

  .diagram__zone-label {
    fill: #6b7594;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------- edges ---------- */
  .diagram__edge-group {
    opacity: 0;
    transition: opacity 520ms ease var(--edge-delay, 0ms);
  }

  .diagram__edge {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 520ms cubic-bezier(0.4, 0, 0.2, 1)
      var(--edge-delay, 0ms);
  }

  .diagram__edge-pill {
    fill: #0c0e16;
    stroke: #7c5cff;
    stroke-opacity: 0.22;
    stroke-width: 1;
  }

  .diagram__edge-label {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    /* exact 0.6em advance keeps the pill width honest — no letter-spacing */
    letter-spacing: 0;
    paint-order: stroke;
    stroke: #06070c;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  /* ---------- nodes ---------- */
  .diagram__plate,
  .diagram__node {
    opacity: 0;
    transform: translateY(7px) scale(0.97);
    transform-box: view-box;
    transform-origin: var(--ox, 50%) var(--oy, 50%);
    transition:
      opacity 380ms cubic-bezier(0.22, 1, 0.36, 1) var(--node-delay, 0ms),
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1) var(--node-delay, 0ms);
  }

  .diagram__spec {
    stroke: #ffffff;
    stroke-opacity: 0.07;
    stroke-width: 1;
  }

  .diagram__chip {
    stroke: #7c5cff;
    stroke-opacity: 0.18;
    stroke-width: 1;
  }

  .diagram__icon {
    color: var(--violet-soft);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .diagram__label {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
  }

  .diagram__sub {
    fill: #8996b0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.02em;
  }

  .diagram__led {
    opacity: 0;
    transition: opacity 300ms ease var(--led-delay, 0ms);
  }

  /* ---------- ports ---------- */
  .diagram__port {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 200ms ease var(--port-delay, 0ms),
      transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--port-delay, 0ms);
  }

  /* ---------- packets ----------
     hidden for the length of the intro so nothing flies along wires that have
     not been drawn yet (and so no unstarted packet shows at the svg origin) */
  .diagram__packets {
    opacity: 0;
    transition: opacity 300ms ease var(--packet-delay, 0ms);
  }

  /* ---------- hit targets ---------- */
  .diagram__hit {
    fill: transparent;
    pointer-events: all;
  }

  /* ---------- drawn state ---------- */
  .diagram.is-drawn .diagram__field,
  .diagram.is-drawn .diagram__grid,
  .diagram.is-drawn .diagram__frame,
  .diagram.is-drawn .diagram__zone,
  .diagram.is-drawn .diagram__led,
  .diagram.is-drawn .diagram__packets {
    opacity: 1;
  }

  .diagram.is-drawn .diagram__zone-rect {
    stroke-dashoffset: 0;
  }

  .diagram.is-drawn .diagram__edge {
    stroke-dashoffset: 0;
  }

  /* dimmable layers resolve their lit opacity through --lit: focus mode swaps
     the variable, so it never has to out-specify the scoped drawn state */
  .diagram.is-drawn .diagram__edge-group {
    opacity: var(--lit, 1);
  }

  .diagram.is-drawn .diagram__plate,
