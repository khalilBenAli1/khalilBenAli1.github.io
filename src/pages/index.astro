---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import TechMarquee from "../components/TechMarquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Diagram from "../components/Diagram.astro";
import AiSection from "../components/AiSection.astro";
import Experience from "../components/Experience.astro";
import SkillsSection from "../components/SkillsSection.astro";
import Contact from "../components/Contact.astro";
import { ui } from "../lib/icons";
import {
  audioDiagram,
  cuddyDiagram,
  lorDiagram,
  meetingDiagram,
  scannerDiagram,
} from "../lib/diagrams-data";
---

<Base space>
  <Nav />

  <main id="main-content">
    <Hero />
    <TechMarquee />

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Selected Work</p>
          <h2 class="section-title" id="work-title">Things I've shipped</h2>
        </div>

        <ProjectCard
          icon="brain-circuit"
          name="Cuddy Brain"
          subtitle="AI operations hub for a US wealth-advisory firm — one screen instead of ten tools."
          year="2024 → now"
          client="Cuddy Financial"
          production
          highlights={[
            "Unified Salesforce, Microsoft 365, RingCentral, QuickBooks + 6 more into one PostgreSQL hub",
            "Every client call auto-transcribed, AI-summarized and routed into Teams within minutes",
            "AI monitoring with deterministic safety gates protects estate work",
          ]}
          techNames={[
            "NestJS",
            "PostgreSQL",
            "Redis",
            "Azure OpenAI",
            "LangChain",
            "React",
            "Microsoft Teams",
            "Salesforce",
          ]}
        >
          <Diagram {...cuddyDiagram} />
        </ProjectCard>

        <ProjectCard
          icon="coffee"
          name="L'OR Unlimited Remix"
          subtitle="AI brand experience and live-event kiosk for JDE's L'OR — sole developer, concept to production."
          year="2026"
          client="JDE × HLWN"
          production
          flip
          highlights={[
            "On-device CLIP vision: selfies analyzed in the browser, photos never leave the device",
            "Gemini-generated recipes with a deterministic fallback — works even fully offline",
            "WebGL fluid simulation at 60fps plus Bluetooth thermal ticket printing at events",
          ]}
          techNames={[
            "Next.js",
            "React",
            "TypeScript",
            "Gemini",
            "transformers.js",
            "WebGL",
            "Tailwind",
            "Vercel",
          ]}
        >
          <Diagram {...lorDiagram} />
        </ProjectCard>

        <ProjectCard
          icon="radio"
          name="nBold Meeting Intelligence"
          subtitle="Teams meeting transcripts captured via Microsoft Graph, AI-summarized, and routed to the right channel by CRM context."
          year="2026"
          client="nBold"
          highlights={[
            "Designed the architecture end to end, then built it solo — 321 tests",
            "Net-new app-only Graph auth unlocking tenant-wide transcript capture",
            "Durable workflows proven crash-safe — zero duplicate deliveries across restarts",
          ]}
          techNames={[
            "NestJS",
            "Microsoft Graph",
            "RabbitMQ",
            "PostgreSQL",
            "Azure OpenAI",
            "Salesforce",
          ]}
        >
          <Diagram {...meetingDiagram} />
        </ProjectCard>

        <ProjectCard
          icon="scan-line"
          name="Cuddy Scanner"
          subtitle="Native .NET 9 document scanner in daily production use at a financial office."
          year="2025 → now"
          client="Cuddy Financial"
          production
          flip
          highlights={[
            "Drives TWAIN office scanners with barcode-based automatic batch splitting",
            "Assembles PDFs and files them straight into SharePoint with metadata",
            "Clean Architecture, MSIX-signed, resumes interrupted scan sessions",
          ]}
          techNames={["C#", ".NET 9", "WPF", "SharePoint", "LiteDB", "MSAL"]}
        >
          <Diagram {...scannerDiagram} />
        </ProjectCard>

        <ProjectCard
          icon="audio-waveform"
          name="HyperMesh & HyperGpu DSP"
          subtitle="C++ audio R&D: GPU-accelerated plugin hosting and a LAN mesh that offloads real-time DSP between machines."
          year="2026"
          client="R&D"
          highlights={[
            "Lock-free buffers, adaptive jitter compensation and FEC over the network",
            "Crash-isolated plugin scanning and cross-platform manager⇄wrapper IPC",
            "CI ships self-contained builds for five platforms",
          ]}
          techNames={["C++20", "JUCE", "CMake", "Protobuf", "SQLite"]}
        >
          <Diagram {...audioDiagram} />
        </ProjectCard>

        <div class="more-work glass-card reveal">
          <div class="more-work__biat">
            <span class="more-work__icon" set:html={ui.database} />
            <div>
              <h3>Assurances BIAT KB</h3>
              <p>
                Explainable RAG chatbot (pgvector + Ollama) with cited, auditable
                answers and role-based access.
              </p>
            </div>
            <a
              class="btn btn--ghost more-work__code"
              href="https://github.com/khalilBenAli1/knowledgebase-"
            >
              <span set:html={ui.github} />
              View code
            </a>
          </div>
          <div class="more-work__cta">
            <p>More projects, experiments and earlier work —</p>
            <a class="btn btn--ghost" href="https://github.com/khalilBenAli1">
              <span set:html={ui.github} />
              github.com/khalilBenAli1
            </a>
          </div>
        </div>
      </div>
    </section>

    <AiSection />
    <Experience />
    <SkillsSection />
    <Contact />
  </main>

  <script>
    import "../scripts/site";
  </script>
</Base>

<style>
  .more-work {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .more-work__biat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
  }

  .more-work__biat > div {
    flex: 1 1 18rem;
  }

  .more-work__icon {
    display: inline-flex;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.5rem;
    border: 1px solid var(--border-accent);
    border-radius: 11px;
    background: rgba(124, 92, 255, 0.12);
    color: var(--violet-soft);
  }

  .more-work__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .more-work__biat h3 {
    margin-bottom: 0.15rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .more-work__biat p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .more-work__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .more-work__cta p {
    margin: 0;
    color: var(--muted);
  }
</style>
